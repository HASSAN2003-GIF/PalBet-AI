APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# PAL-PREDICT (the PALBET_* / config('palbet.*') names are kept for compatibility)
ODDS_API_KEY=
GEMINI_API_KEY=
# Optional: override the Gemini model the analyst uses, and the one it falls back to
# when the main model is overloaded.
GEMINI_MODEL=
GEMINI_FALLBACK_MODEL=
# Live Google Search for the analyst (injuries, press conferences, late news). Needs
# billing enabled on the Gemini project; when Google refuses a search the analyst still
# answers, from ESPN data and the model, and says what it could not check.
ANALYST_WEB_SEARCH=true
# Free ESPN match data for the analyst: table, last results, head-to-head, news, line-ups.
ANALYST_ESPN=true
# Automatic odds refresh (needs the scheduler: a cron running `php artisan schedule:run`
# every minute). Off by default because every league scanned costs Odds API credits.
PALBET_ODDS_SCHEDULE=false
# The hourly refresh covers leagues with a match kicking off within this many hours.
PALBET_ODDS_REFRESH_HOURS=3
# Engine: whose prices are the probabilities ("pinnacle", or "none" for the all-book consensus)
RISK_ENGINE_ANCHOR=pinnacle
# Admin dashboard password. Empty = admin endpoints disabled.
ADMIN_PASSWORD=
# Frontend: where the React app finds this API (defaults to the Render URL in production)
VITE_API_URL=
